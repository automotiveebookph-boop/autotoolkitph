---
import BaseLayout from '../layouts/BaseLayout.astro';
import { BRAND_NAME } from '../config/site';
---

<BaseLayout title={`Page not found — ${BRAND_NAME}`} description="Page not found." noindex>
  <section class="section nf">
    <div class="container container-narrow">
      <p class="code" aria-hidden="true">404</p>
      <h1>Naligaw ka yata.</h1>
      <p class="lead">Wala dito ang page na hinahanap mo. Baka luma na ang link o may typo.</p>
      <a href="/" class="home">Bumalik sa homepage</a>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    text-align: center;
    min-height: 60vh;
    display: grid;
    align-items: center;
  }
  .nf .container > * + * {
    margin-top: var(--space-4);
  }
  .code {
    font-family: var(--font-h);
    font-weight: 800;
    font-size: clamp(5rem, 4rem + 8vw, 9rem);
    line-height: 1;
    color: var(--color-dark);
    letter-spacing: -0.04em;
  }
  .code::after {
    content: '';
    display: block;
    width: 4rem;
    height: 0.4rem;
    margin: var(--space-4) auto 0;
    border-radius: 99px;
    background: var(--color-accent);
  }
  .home {
    display: inline-flex;
    align-items: center;
    min-height: 54px;
    margin-top: var(--space-6) !important;
    padding: 0 var(--space-6);
    border-radius: 999px;
    background: var(--color-accent);
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }
  .home:hover {
    background: var(--color-accent-hover);
    color: #fff;
  }
</style>
