---
/**
 * TODO(pre-launch): have this privacy policy reviewed by a qualified person
 * (ideally a lawyer familiar with RA 10173 / NPC rules) before running ads.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { BRAND_NAME, MESSENGER_BASE, PAYMENT_METHODS } from '../config/site';

const updated = 'October 2, 2026'; // TODO: update when the policy changes
const payments = PAYMENT_METHODS.join(' / ');
// Contact goes through Messenger (not a link to the Facebook page) so the page name isn't shown on the site.
const contactUrl = `${MESSENGER_BASE}?ref=privacy`;
---

<BaseLayout title={`Privacy Policy — ${BRAND_NAME}`} description={`How ${BRAND_NAME} collects and uses your information. Paano namin ginagamit ang impormasyon mo.`}>
  <article class="section">
    <div class="container container-narrow prose">
      <h1>Privacy Policy</h1>
      <p class="muted">Last updated: {updated}</p>

      <nav aria-label="Language" class="lang">
        <a href="#english">English</a>
        <a href="#filipino">Filipino</a>
      </nav>

      <section id="english" aria-labelledby="en-h">
        <h2 id="en-h">English</h2>

        <h3>Who we are</h3>
        <p>
          {BRAND_NAME} sells downloadable (PDF) automotive guides. This policy explains what information we collect and how
          we use it, in line with the Philippine Data Privacy Act of 2012 (Republic Act No. 10173).
        </p>

        <h3>What we collect</h3>
        <ul>
          <li>
            <strong>When you order:</strong> orders happen in Facebook Messenger, not on this website. We only collect what
            we need to deliver your product: your <strong>name</strong> as shown in Messenger, your <strong>payment screenshot</strong>
            ({payments}), and your <strong>email address</strong> only if you choose to give it.
          </li>
          <li>
            <strong>When you visit this website:</strong> we use the <strong>Meta Pixel</strong>, a tool from Meta
            (Facebook), to measure how our ads perform — for example, which pages were viewed and whether a "Order via
            Messenger" button was tapped. Meta may use cookies and receive information such as your IP address and browser
            details. This site has no forms and no accounts.
          </li>
        </ul>

        <h3>How we use it</h3>
        <ul>
          <li>To verify your payment and send your download link by Messenger.</li>
          <li>To print your name (and email, if given) and order number on your copy of the kit, for personal use.</li>
          <li>To answer your questions and handle refund requests.</li>
          <li>To measure and improve our ads.</li>
        </ul>

        <h3>What we don't do</h3>
        <p>We do not sell, rent, or trade your personal data. We only share it with the services needed to run the business (Meta/Messenger and {payments}).</p>

        <h3>How long we keep it</h3>
        <p>We keep order records only as long as needed to deliver your product, handle refunds, and meet legal or tax requirements.</p>

        <h3>Your rights</h3>
        <p>
          Under RA 10173 you have the right to be informed, to access, to correct, and to ask us to delete your personal
          data, and to object to its processing. You can also control ad tracking in your Facebook "Ad preferences" and your
          browser's cookie settings.
        </p>

        <h3>Contact us</h3>
        <p>Message us on <a href={contactUrl} rel="noopener">Messenger</a> for any privacy question or request.</p>
      </section>

      <section id="filipino" aria-labelledby="fil-h">
        <h2 id="fil-h">Filipino</h2>

        <h3>Sino kami</h3>
        <p>
          Nagbebenta ang {BRAND_NAME} ng downloadable (PDF) na automotive guides. Ipinapaliwanag ng policy na ito kung anong
          impormasyon ang kinokolekta namin at paano namin ito ginagamit, alinsunod sa Data Privacy Act of 2012 (Republic Act
          No. 10173).
        </p>

        <h3>Ano ang kinokolekta namin</h3>
        <ul>
          <li>
            <strong>Kapag nag-order ka:</strong> sa Facebook Messenger nangyayari ang order, hindi sa website na ito. Ang
            kinukuha lang namin ay ang kailangan para maipadala ang produkto: ang <strong>pangalan</strong> mo sa Messenger, ang
            <strong>screenshot ng bayad</strong> ({payments}), at ang <strong>email address</strong> mo kung ibibigay mo ito.
          </li>
          <li>
            <strong>Kapag bumisita ka sa website:</strong> gumagamit kami ng <strong>Meta Pixel</strong> mula sa Meta
            (Facebook) para masukat kung gaano kaepektibo ang ads namin — halimbawa, anong pages ang tiningnan at kung na-tap
            ang "Order via Messenger" button. Maaaring gumamit ang Meta ng cookies at makatanggap ng impormasyon tulad ng IP
            address at browser details mo. Walang forms o accounts sa site na ito.
          </li>
        </ul>

        <h3>Paano namin ginagamit</h3>
        <ul>
          <li>Para ma-verify ang bayad at maipadala ang download link sa Messenger.</li>
          <li>Para i-print ang pangalan mo (at email, kung ibinigay) at order number sa kopya mo ng kit, para sa personal na gamit.</li>
          <li>Para sagutin ang mga tanong mo at asikasuhin ang refund requests.</li>
          <li>Para masukat at mapaganda ang ads namin.</li>
        </ul>

        <h3>Hindi namin ginagawa</h3>
        <p>Hindi namin ibinebenta, pinapaupahan, o ipinagpapalit ang personal data mo. Ibinabahagi lang namin ito sa mga serbisyong kailangan para patakbuhin ang negosyo (Meta/Messenger at {payments}).</p>

        <h3>Gaano katagal namin itinatago</h3>
        <p>Itinatago lang namin ang order records hangga't kailangan para sa delivery, refunds, at legal o tax requirements.</p>

        <h3>Mga karapatan mo</h3>
        <p>
          Sa ilalim ng RA 10173, may karapatan kang malaman, ma-access, maitama, at ipabura ang personal data mo, at tumutol
          sa pagproseso nito. Makokontrol mo rin ang ad tracking sa "Ad preferences" ng Facebook at sa cookie settings ng
          browser mo.
        </p>

        <h3>Makipag-ugnayan</h3>
        <p>I-message kami sa <a href={contactUrl} rel="noopener">Messenger</a> para sa anumang tanong o request tungkol sa privacy.</p>
      </section>
    </div>
  </article>
</BaseLayout>

<style>
  .prose > * + * {
    margin-top: var(--space-4);
  }
  .prose section {
    margin-top: var(--space-7);
  }
  .prose section > * + * {
    margin-top: var(--space-3);
  }
  .prose h3 {
    margin-top: var(--space-5) !important;
  }
  .prose ul {
    padding-left: 1.25rem;
    display: grid;
    gap: var(--space-2);
  }
  .lang {
    display: flex;
    gap: var(--space-2);
  }
  .lang a {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-surface);
    font-weight: 600;
    text-decoration: none;
  }
</style>
