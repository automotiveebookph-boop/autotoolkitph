---
import { Font } from 'astro:assets';
import { BRAND_NAME, BUILD_COMMIT, BUILD_ENV, LOGOS, OG_DEFAULT } from '../config/site';

interface Props {
  title: string;
  description: string;
  /** Absolute or root-relative URL of the share image. Defaults to /brand/og-default.jpg */
  ogImage?: string;
  ogType?: 'website' | 'product';
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, ogImage = OG_DEFAULT, ogType = 'website', noindex = false, jsonLd } = Astro.props;

const site = Astro.site!;
// Canonical: no trailing slash, no query string (drops fbclid etc.)
const path =
  Astro.url.pathname
    .replace(/\.html$/, '')
    .replace(/(^|\/)index$/, '')
    .replace(/\/$/, '') || '/';
const canonical = new URL(path, site).href;
const image = new URL(ogImage, site).href;
const jsonLdList = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
<title>{title}</title>
<meta name="description" content={description} />
{noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
<meta name="theme-color" content="#1B1D1F" />
<!-- Which commit / Vercel environment built this page (read by scripts/launch-check.mjs) -->
<meta name="x-build" content={`${BUILD_COMMIT} ${BUILD_ENV}`} />
<link rel="icon" href={LOGOS.mark.src} type="image/svg+xml" />

<Font cssVariable="--font-heading" preload={[{ weight: 800, subset: 'latin' }]} />
<Font cssVariable="--font-body" preload={[{ weight: 400, subset: 'latin' }]} />

<meta property="og:site_name" content={BRAND_NAME} />
<meta property="og:locale" content="fil_PH" />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={image} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={image} />

{jsonLdList.map((data) => <script type="application/ld+json" is:inline set:html={JSON.stringify(data).replace(/</g, '\\u003c')} />)}
