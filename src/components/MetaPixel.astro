---
/**
 * Meta Pixel — the ONE place all ad tracking lives.
 *
 * The ID comes from the PUBLIC_META_PIXEL_ID environment variable (set it in Vercel →
 * Settings → Environment Variables, then redeploy). With no ID, Meta's script is never
 * loaded and nothing is sent; the small inline script below exits immediately unless
 * debug mode is on.
 *
 * Events:
 *   1. PageView     — every page, on load.
 *   2. ViewContent  — once per page, when the pricing block ([data-track-view-content])
 *                     scrolls into view. Params: content_ids [slug], content_name,
 *                     content_type, value (price), currency PHP.
 *   3. Contact      — every click on a Messenger CTA (a[data-cta]). Same product params
 *                     plus `ref` (e.g. "inspection-kit_hero") so you can see which button.
 *
 * Debug mode: add ?pixel_debug=1 to any URL. Every event is logged to the browser console
 * (and still sent to Meta when an ID is set). Without an ID it logs "NOT SENT".
 *
 * Product data is read from data-* attributes rendered by CTAButton / PriceBlock,
 * so this file never needs to change when products are added.
 */
import { META_PIXEL_ID } from '../config/site';

const pixelId = META_PIXEL_ID;
---

<script is:inline set:html={`var PIXEL_ID = ${JSON.stringify(pixelId)};`} />
<script is:inline>
  (function () {
    var id = window.PIXEL_ID;
    var debug = /[?&]pixel_debug=1(&|$)/.test(location.search);
    if (!id && !debug) return;

    if (id) {
      /* Standard Meta Pixel loader */
      !(function (f, b, e, v, n, t, s) {
        if (f.fbq) return;
        n = f.fbq = function () {
          n.callMethod ? n.callMethod.apply(n, arguments) : n.queue.push(arguments);
        };
        if (!f._fbq) f._fbq = n;
        n.push = n;
        n.loaded = !0;
        n.version = '2.0';
        n.queue = [];
        t = b.createElement(e);
        t.async = !0;
        t.src = v;
        s = b.getElementsByTagName(e)[0];
        s.parentNode.insertBefore(t, s);
      })(window, document, 'script', 'https://connect.facebook.net/en_US/fbevents.js');
      window.fbq('init', id);
    }

    function track(event, params) {
      if (debug) {
        console.log(
          '%c[Meta Pixel]%c ' + event + (id ? '  → sent to Pixel ' + id : '  → NOT SENT (no PUBLIC_META_PIXEL_ID)'),
          'color:#487219;font-weight:bold',
          'color:inherit',
          params || {},
        );
      }
      if (id) {
        if (params) window.fbq('track', event, params);
        else window.fbq('track', event);
      }
    }

    function productParams(el) {
      var d = el.dataset;
      var params = { content_ids: [d.slug], content_name: d.name, content_type: 'product' };
      if (d.price) {
        params.value = Number(d.price);
        params.currency = 'PHP';
      }
      return params;
    }

    /* 1. PageView — every page */
    track('PageView');

    /* 2. ViewContent — once per page, when the pricing block enters the viewport */
    var pricing = document.querySelector('[data-track-view-content]');
    if (pricing && 'IntersectionObserver' in window) {
      var io = new IntersectionObserver(
        function (entries) {
          if (entries.some(function (e) { return e.isIntersecting; })) {
            io.disconnect();
            track('ViewContent', productParams(pricing));
          }
        },
        { threshold: 0.3 },
      );
      io.observe(pricing);
    }

    /* 3. Contact — every Messenger CTA click (event delegation covers all buttons) */
    document.addEventListener('click', function (ev) {
      var a = ev.target.closest && ev.target.closest('a[data-cta]');
      if (!a) return;
      var params = productParams(a);
      params.ref = a.dataset.ref;
      track('Contact', params);
    });
  })();
</script>

{
  pixelId && (
    <noscript>
      <img height="1" width="1" style="display:none" alt="" src={`https://www.facebook.com/tr?id=${pixelId}&ev=PageView&noscript=1`} />
    </noscript>
  )
}
