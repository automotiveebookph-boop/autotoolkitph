---
import { GUARANTEE_TEXT } from '../config/site';

interface Props {
  body: string;
}
const { body } = Astro.props;
---

<div class="guarantee">
  <svg viewBox="0 0 24 24" width="32" height="32" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M12 1.5 3.5 5v6.2c0 5.3 3.6 10.2 8.5 11.3 4.9-1.1 8.5-6 8.5-11.3V5L12 1.5Zm-1.3 14.8-3.9-3.9 1.4-1.4 2.5 2.5 5.2-5.2 1.4 1.4-6.6 6.6Z"
    ></path>
  </svg>
  <div>
    <p class="title">{GUARANTEE_TEXT}</p>
    <p class="body">{body}</p>
  </div>
</div>

<style>
  .guarantee {
    display: flex;
    gap: var(--space-3);
    align-items: flex-start;
    padding: var(--space-4);
    background: var(--color-accent-tint);
    border: 1px solid #cfe0b8;
    border-radius: var(--radius);
    text-align: left;
  }
  svg {
    flex-shrink: 0;
    color: var(--color-accent);
  }
  .title {
    font-weight: 700;
    color: var(--color-text);
  }
  .body {
    font-size: var(--fs-sm);
    color: var(--color-text-muted);
  }
</style>
