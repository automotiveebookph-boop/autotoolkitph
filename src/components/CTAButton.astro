---
/**
 * Messenger buy button. Links to https://m.me/<FB_PAGE_NAME>?ref=<slug>_<location>
 * and carries data-* attributes that MetaPixel.astro reads for the Contact event.
 */
import { formatPrice, messengerLink, type CtaLocation, type Product } from '../lib/products';

interface Props {
  product: Pick<Product, 'slug' | 'name' | 'price'>;
  location: CtaLocation;
  label?: string;
  variant?: 'primary' | 'bright';
  block?: boolean;
  class?: string;
}

const { product, location, label, variant = 'primary', block = false, class: className } = Astro.props;
const ref = `${product.slug}_${location}`;
const text = label ?? `Order via Messenger — ${formatPrice(product.price)}`;
---

<a
  href={messengerLink(product.slug, location)}
  class:list={['cta', `cta--${variant}`, { 'cta--block': block }, className]}
  data-cta
  data-ref={ref}
  data-slug={product.slug}
  data-name={product.name}
  data-price={product.price}
>
  <svg class="icon" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
    <path
      fill="currentColor"
      d="M12 2C6.36 2 2 6.13 2 11.7c0 2.91 1.19 5.44 3.14 7.17.16.15.26.35.27.57l.05 1.78c.02.57.6.94 1.12.71l1.99-.88c.17-.07.36-.09.54-.04.91.25 1.89.39 2.89.39 5.64 0 10-4.13 10-9.7C22 6.13 17.64 2 12 2Zm6 7.46-2.94 4.66c-.47.74-1.47.93-2.17.4l-2.34-1.75a.6.6 0 0 0-.72 0l-3.16 2.4c-.42.32-.97-.18-.69-.63l2.94-4.66c.47-.74 1.47-.93 2.17-.4l2.34 1.75a.6.6 0 0 0 .72 0l3.16-2.4c.42-.32.97.18.69.63Z"
    ></path>
  </svg>
  <span>{text}</span>
</a>

<style>
  .cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    min-height: 54px;
    padding: var(--space-3) var(--space-5);
    border-radius: 999px;
    font-family: var(--font-b);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.25;
    text-align: center;
    text-decoration: none;
    transition:
      background-color 0.15s ease,
      transform 0.15s ease;
  }
  .cta:active {
    transform: translateY(1px);
  }
  .cta--primary {
    background: var(--color-accent);
    color: #fff;
    box-shadow: 0 6px 16px rgb(72 114 25 / 0.28);
  }
  .cta--primary:hover {
    background: var(--color-accent-hover);
    color: #fff;
  }
  /* For dark backgrounds: lime button with dark text (9.6:1) */
  .cta--bright {
    background: var(--color-accent-bright);
    color: var(--color-dark);
  }
  .cta--bright:hover {
    background: #c4dd4f;
    color: var(--color-dark);
  }
  .cta--block {
    display: flex;
    width: 100%;
  }
  .icon {
    flex-shrink: 0;
  }
</style>
