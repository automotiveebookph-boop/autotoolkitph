---
import { BRAND_NAME, LOGOS } from '../config/site';

interface Props {
  cta?: { href: string; label: string };
}
const { cta = { href: '/#products', label: 'Mga kit' } } = Astro.props;
const logo = LOGOS.horizontalLight;
---

<header class="site-header">
  <div class="container inner">
    <a href="/" class="logo" aria-label={`${BRAND_NAME} — home`}>
      <img src={logo.src} width={logo.width} height={logo.height} alt={BRAND_NAME} fetchpriority="high" />
    </a>
    <a href={cta.href} class="header-cta">{cta.label}</a>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 40;
    background: rgb(245 245 242 / 0.94);
    backdrop-filter: saturate(1.4) blur(8px);
    -webkit-backdrop-filter: saturate(1.4) blur(8px);
    border-bottom: 1px solid var(--color-border);
  }
  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 60px;
  }
  .logo {
    display: flex;
    align-items: center;
    min-height: var(--tap);
    flex-shrink: 1;
    min-width: 0;
  }
  .logo img {
    height: 32px;
    width: auto;
  }
  .header-cta {
    display: inline-flex;
    align-items: center;
    min-height: var(--tap);
    padding: 0 var(--space-4);
    border: 2px solid var(--color-accent);
    border-radius: 999px;
    color: var(--color-accent);
    font-weight: 700;
    font-size: var(--fs-sm);
    text-decoration: none;
    white-space: nowrap;
    flex-shrink: 0;
  }
  .header-cta:hover {
    background: var(--color-accent);
    color: #fff;
  }
</style>
